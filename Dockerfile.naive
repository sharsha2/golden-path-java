# Pinned by digest only to satisfy OpenSSF Scorecard. Everything else in this
# file is still deliberately wrong: root user, build toolchain in the final
# image, and an indiscriminate COPY. See README.
FROM eclipse-temurin:25-jdk@sha256:2d5d5e9b533342a565907c84f47a2ec298c40cde7b13a3ca85d4950fa456a641
WORKDIR /app
COPY . .
RUN ./mvnw -B -q package -DskipTests
EXPOSE 8080
CMD ["sh", "-c", "java -jar target/*.jar"]